---
import { Icon } from 'astro-icon/components';
import ArticleCard from './ArticleCard.astro';
import { articles, MEDIUM_PROFILE } from '../data/articles';
import type { Lang } from '../i18n/types';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="articles" class="mx-auto max-w-[1200px] px-8 py-20">
  <h2 class="mb-4 text-center text-4xl font-semibold text-white">{t('articlesHeading')}</h2>
  <p class="mx-auto max-w-[680px] text-center text-muted">{t('articlesIntro')}</p>

  <div class="mt-12 grid grid-cols-1 gap-6 tablet:grid-cols-2">
    {articles.map((article) => <ArticleCard article={article} lang={lang} />)}
  </div>

  <div class="mt-10 text-center">
    <a
      href={MEDIUM_PROFILE}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-[8px] border-2 border-transparent bg-card px-4 py-2 font-medium text-white transition-all duration-300 hover:border-white hover:bg-card-hover"
    >
      <Icon name="ri:medium-fill" />
      {t('allArticles')}
    </a>
  </div>
</section>
