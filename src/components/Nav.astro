---
// Top navigation: on the home page it shows the in-page "Services" anchor; on any
// other page that first item becomes a "Home" link back to the index of the
// current language. "Articles" targets the same section on the home page, so off
// the home page it links back to the index with the anchor attached. Also a
// "Projects" page link, an external GitHub link, and the language switcher.
import type { Lang } from '../i18n/types';
import { useTranslations } from '../i18n/ui';
import { localizePath, stripLang } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Compare against the canonical path so /hu/ counts as home just like /.
const isHome = stripLang(Astro.url.pathname) === '/';

// The articles section lives on the home page, so away from it the anchor needs
// the index path in front of it to work as a link.
const articlesHref = isHome ? '#articles' : `${localizePath(lang, '/')}#articles`;
---

<nav class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-3 gap-y-4 px-4 py-6 tablet:gap-8 tablet:py-8">
  <ul class="flex list-none flex-wrap items-center gap-x-4 gap-y-2 text-[0.9rem] tablet:gap-8 tablet:text-base desktop:gap-12">
    <li class="link">
      {
        isHome ? (
          <a href="#services" class="relative pb-3 text-white">
            {t('navServices')}
          </a>
        ) : (
          <a href={localizePath(lang, '/')} class="relative pb-3 text-white">
            {t('navHome')}
          </a>
        )
      }
    </li>
    <li class="link">
      <a href={articlesHref} class="relative pb-3 text-white">{t('navArticles')}</a>
    </li>
    <li class="link">
      <a href={localizePath(lang, '/projects/')} class="relative pb-3 text-white"
        >{t('navProjects')}</a
      >
    </li>
    <li class="link">
      <a
        href="https://github.com/Ricsi1231"
        target="_blank"
        rel="noopener noreferrer"
        class="relative pb-3 text-white">{t('navGithub')}</a
      >
    </li>
  </ul>

  <!-- ml-auto keeps the switcher hard right even if the links wrap to their own row. -->
  <div class="ml-auto">
    <LanguageSwitcher lang={lang} />
  </div>
</nav>

<style>
  /* Animated underline on hover, ported from .link a::after in style.css */
  .link a::after {
    content: '';
    position: absolute;
    height: 2px;
    width: 0;
    bottom: 0;
    left: 0;
    background-color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .link a:hover::after {
    width: 70%;
  }
</style>
