---
// Top navigation: on the home page it shows the in-page "Services" anchor; on any
// other page that first item becomes a "Home" link back to the index of the
// current language. Also a "Projects" page link, an external GitHub link, and the
// language switcher.
import type { Lang } from '../i18n/types';
import { useTranslations } from '../i18n/ui';
import { localizePath, stripLang } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Compare against the canonical path so /hu/ counts as home just like /.
const isHome = stripLang(Astro.url.pathname) === '/';
---

<nav class="mx-auto flex max-w-[1200px] items-center justify-between gap-8 px-4 py-8">
  <ul class="hidden list-none items-center gap-12 desktop:flex">
    <li class="link">
      {
        isHome ? (
          <a href="#services" class="relative pb-3 text-white">
            {t('navServices')}
          </a>
        ) : (
          <a href={localizePath(lang, '/')} class="relative pb-3 text-white">
            {t('navHome')}
          </a>
        )
      }
    </li>
    <li class="link">
      <a href={localizePath(lang, '/projects/')} class="relative pb-3 text-white"
        >{t('navProjects')}</a
      >
    </li>
    <li class="link">
      <a
        href="https://github.com/Ricsi1231"
        target="_blank"
        rel="noopener noreferrer"
        class="relative pb-3 text-white">{t('navGithub')}</a
      >
    </li>
  </ul>

  <!-- ml-auto keeps the switcher right-aligned below the `desktop` breakpoint,
       where the link list above is hidden and would otherwise leave it alone. -->
  <div class="ml-auto">
    <LanguageSwitcher lang={lang} />
  </div>
</nav>

<style>
  /* Animated underline on hover, ported from .link a::after in style.css */
  .link a::after {
    content: '';
    position: absolute;
    height: 2px;
    width: 0;
    bottom: 0;
    left: 0;
    background-color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .link a:hover::after {
    width: 70%;
  }
</style>
