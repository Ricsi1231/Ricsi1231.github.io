---
// Hero / header section: intro heading, bio, and portrait image. The copy itself
// lives in src/data/hero.ts so both languages sit side by side.
import { hero } from '../data/hero';
import type { Lang } from '../i18n/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header
  class="relative mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-8 px-8 pt-8 pb-20 desktop:grid-cols-2"
>
  <div class="content relative">
    <span class="blur"></span>
    <span class="blur"></span>
    <!-- Hungarian compounds ("mérnökhallgató") are longer than their English
         counterparts, so the heading steps down below the tablet breakpoint
         instead of overflowing the viewport. -->
    <h1
      class="mb-4 text-4xl font-bold leading-tight hyphens-auto break-words text-white tablet:text-5xl tablet:leading-[4rem]"
      set:html={hero.heading[lang]}
    />
    <p class="mb-8 text-muted" set:html={hero.body[lang]} />
  </div>
  <div class="image relative">
    <img
      src="/images/header.png"
      alt={hero.portraitAlt}
      class="mx-auto flex max-w-[600px]"
    />
  </div>
</header>

<style>
  /* Blue accent glow, ported from .blur in style.css */
  .blur {
    position: absolute;
    box-shadow: 0 0 1000px 50px var(--color-accent);
    z-index: -100;
  }

  /* Outlined text for the name, ported from header .content h1 span */
  .content h1 :global(.stroke) {
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 1px #fff;
  }

  /* Giant faint "o" watermark behind the portrait, ported from header .image::before */
  .image::before {
    content: 'o';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 38rem;
    font-weight: 400;
    line-height: 20rem;
    color: var(--color-accent);
    opacity: 0.2;
    z-index: -100;
  }

  @media (width < 600px) {
    .image::before {
      display: none;
    }
  }
</style>
