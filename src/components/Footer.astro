---
// Site footer: contact address and copyright. Rendered on every page so a
// visitor can reach out from wherever they landed, including a project page
// opened straight from a shared link.
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/types';
import { useTranslations } from '../i18n/ui';

const CONTACT_EMAIL = 'richardnagy551@gmail.com';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="mx-auto max-w-[1200px] px-4 py-10 text-center">
  <p class="mb-3 text-[0.9rem] text-muted">{t('contactLabel')}</p>

  <a
    href={`mailto:${CONTACT_EMAIL}`}
    class="inline-flex items-center gap-2 rounded-[8px] border-2 border-transparent bg-card px-4 py-2 font-medium text-white transition-all duration-300 hover:border-white hover:bg-card-hover"
  >
    <Icon name="ri:mail-line" />
    {CONTACT_EMAIL}
  </a>

  <p class="mt-8 text-[0.8rem] text-white">{t('footer')}</p>
</footer>
