---
import { Icon } from 'astro-icon/components';
import type { Service } from '../data/services';
import type { Lang } from '../i18n/types';

interface Props {
  service: Service;
  lang: Lang;
}

const { service, lang } = Astro.props;
const { icon, title, body } = service;
---

<div
  class="card rounded-[15px] border-2 border-transparent bg-card p-4 transition-all duration-300 hover:border-white hover:bg-card-hover"
>
  <span
    class="mb-4 inline-block rounded-[5px] bg-accent-dark px-[9px] py-[2px] text-[1.75rem] text-white"
  >
    <Icon name={icon} />
  </span>
  <h4 class="mb-2 text-[1.2rem] font-semibold text-white">{title[lang]}</h4>
  <p class="mb-4 text-muted" set:html={body[lang]} />
</div>
