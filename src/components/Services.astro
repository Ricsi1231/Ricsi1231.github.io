---
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';
import type { Lang } from '../i18n/types';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="mx-auto max-w-[1200px] px-8 py-20">
  <h2 class="mb-4 text-center text-4xl font-semibold text-white">{t('servicesHeading')}</h2>
  <div class="mt-16 grid grid-cols-1 gap-6 tablet:grid-cols-2 desktop:grid-cols-5">
    {services.map((service) => <ServiceCard service={service} lang={lang} />)}
  </div>
</section>
