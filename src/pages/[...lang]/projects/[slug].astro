---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { resolveImage } from '../../../data/images';
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { projects, type Project } from '../../../data/projects';
import { LANGS, type Lang } from '../../../i18n/types';
import { useTranslations } from '../../../i18n/ui';
import { langParam, localizePath } from '../../../i18n/utils';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang: langParam(lang), slug: project.slug },
      props: { lang, project },
    }))
  );
}

type Props = { lang: Lang; project: Project };

const { lang, project } = Astro.props;
const { title, description, links, images = [] } = project;
const t = useTranslations(lang);

// A lone image is centered in a narrower single column; multiple images use a
// two-column grid.
const isSingleImage = images.length === 1;
const galleryClass = isSingleImage
  ? 'mx-auto grid max-w-[640px] grid-cols-1 justify-items-center gap-8'
  : 'mx-auto grid max-w-[1000px] grid-cols-1 justify-items-center gap-8 tablet:grid-cols-2';
---

<Layout title={`${title[lang]} — ${t('siteName')}`} lang={lang}>
  <Nav lang={lang} />
  <article class="mx-auto max-w-[1200px] px-8 py-20">
    <a
      href={localizePath(lang, '/projects/')}
      class="mb-8 inline-block text-muted transition-colors hover:text-white"
    >
      {t('backToProjects')}
    </a>

    <h1 class="mb-6 text-4xl font-semibold text-white">{title[lang]}</h1>
    <p class="mb-8 text-muted" set:html={description[lang]} />

    {
      links.length > 0 && (
        <div class="mb-12 flex flex-wrap gap-4">
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-[8px] bg-accent px-4 py-2 font-medium text-white transition-colors hover:bg-accent-dark"
            >
              {link.icon && <Icon name={link.icon} />}
              {link.label[lang]}
            </a>
          ))}
        </div>
      )
    }

    {
      images.length > 0 && (
        <div class={galleryClass}>
          {images.map((image, index) => {
            const asset = resolveImage(image);
            return (
              <a
                href={asset.src}
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center rounded-[15px] border-2 border-transparent bg-card p-3 transition-all duration-300 hover:border-white"
              >
                <Image
                  src={asset}
                  alt={`${title[lang]} — ${t('image')} ${index + 1}`}
                  widths={[480, 960, 1440]}
                  sizes="(min-width: 600px) 50vw, 100vw"
                  format="webp"
                  class="max-h-[360px] w-auto rounded-[10px] object-contain"
                />
              </a>
            );
          })}
        </div>
      )
    }
  </article>
  <Footer lang={lang} />
</Layout>
