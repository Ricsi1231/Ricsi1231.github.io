---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import { orderedProjects } from '../../data/projects';
import { LANGS, type Lang } from '../../i18n/types';
import { useTranslations } from '../../i18n/ui';
import { langParam } from '../../i18n/utils';

export function getStaticPaths() {
  return LANGS.map((lang) => ({
    params: { lang: langParam(lang) },
    props: { lang },
  }));
}

type Props = { lang: Lang };

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={`${t('projectsHeading')} — ${t('siteName')}`} lang={lang}>
  <Nav lang={lang} />
  <section class="mx-auto max-w-[1200px] px-8 py-20">
    <h1 class="mb-4 text-center text-4xl font-semibold text-white">{t('projectsHeading')}</h1>
    <CategoryTabs lang={lang} active={null} />
    <div class="mt-12 grid grid-cols-1 gap-8 tablet:grid-cols-2 desktop:grid-cols-4">
      {orderedProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
  <Footer lang={lang} />
</Layout>
